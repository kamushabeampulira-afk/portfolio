# Copy this file to .env for local development.
# On Render, set these as environment variables in the dashboard/blueprint instead.

# Get this from https://app.pinecone.io/
PINECONE_API_KEY=

# Get this from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: used as OpenRouter's HTTP-Referer header
FRONTEND_URL=http://localhost:5000

# Optional: port for the local server (Render sets this automatically)
PORT=5000
